{
  "name": "beamlab-leo",
  "private": true,
  "version": "2.4.0-beta.4",
  "description": "Simulador interactivo de órbita, arreglos en fase y beamforming satelital en órbita LEO",
  "homepage": "https://gcrownv-glitch.github.io/beamlab-leo/",
  "repository": {
    "type": "git",
    "url": "https://github.com/gcrownv-glitch/beamlab-leo.git"
  },
  "bugs": {
    "url": "https://github.com/gcrownv-glitch/beamlab-leo/issues"
  },
  "author": {
    "name": "Jhorel Kennedy Cornejo Cruz",
    "url": "https://github.com/gcrownv-glitch"
  },
  "license": "MIT",
  "keywords": [
    "satellite",
    "beamforming",
    "phased-array",
    "leo",
    "link-budget",
    "threejs"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "preview:lan": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "version:check": "node scripts/bump-version.mjs --check",
    "version:bump": "node scripts/bump-version.mjs",
    "build:portable": "npm run build && node scripts/build-portable.mjs && powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-launcher.ps1",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:win": "tauri build --bundles nsis",
    "tauri:build:linux": "tauri build --bundles deb,appimage",
    "tauri:build:mac": "tauri build --target aarch64-apple-darwin --bundles dmg"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "jspdf": "^4.2.1",
    "katex": "0.16.22",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.4",
    "@types/three": "0.187.0",
    "typescript": "5.9.3",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
