{
  "name": "beamlab-leo",
  "private": true,
  "version": "1.1.1",
  "description": "Simulador interactivo de órbita, arreglos en fase y beamforming satelital en órbita LEO",
  "homepage": "https://gcrownv-glitch.github.io/beamlab-leo/",
  "repository": {
    "type": "git",
    "url": "https://github.com/gcrownv-glitch/beamlab-leo.git"
  },
